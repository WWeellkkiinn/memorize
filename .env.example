# First-run admin bootstrap. On startup the server creates this admin ONLY if it
# doesn't already exist — it never overwrites an existing admin's password, so a
# password you change in-app survives redeploys. Registration is admin-only, so
# this is how the very first account is created.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_at_least_8_chars

# Session cookie Secure flag. Defaults to 1 (HTTPS-only) — the production default.
# Set to 0 ONLY for plain-HTTP local development, otherwise the browser will
# refuse to store/send the cookie and login will appear to silently fail.
SECURE_COOKIES=1

# Shown on the settings page as the current build version. Bump it on each deploy
# (together with the service-worker CACHE name) so users can tell when they've
# updated. Defaults to "dev" if unset.
APP_VERSION=dev
